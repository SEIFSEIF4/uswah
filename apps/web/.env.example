NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret for POST /api/revalidate and POST /api/notify
REVALIDATE_SECRET=

# Postgres password, for migrations and `pnpm db:types` (scripts/gen-types.sh)
SUPABASE_DB_PASSWORD=

# Web Push (generate with: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for the VAPID subject, e.g. mailto:hello@uswah.app
VAPID_SUBJECT=
